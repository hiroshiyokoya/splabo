{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "splabo",
  "version": "0.0.0-dev",
  "identifier": "com.splabo.app",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SpLabo - Splatoon3 バトル & ギア 分析アプリ",
        "width": 1360,
        "height": 950,
        "minWidth": 900,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "externalBin": [
      "binaries/nxapi-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1 | libappindicator3-1"]
      },
      "rpm": {
        "depends": ["libappindicator-gtk3"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["npf71b963c1b7b6d119"]
      }
    }
  }
}
